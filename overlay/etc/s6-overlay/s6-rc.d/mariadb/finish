#!/usr/bin/nu

use bf
use bf-mariadb
use bf-s6
bf env load -x mariadb

# Stop server and terminate container
def main [...args] {
    # old PIDs clog up the mysql directory
    bf write "Clearing temporary files and old process IDs."
    let data = bf env DB_DATA
    [ $"($data)/*.err" $"($data)/*.pid" ] | into glob | rm --force ...$in

    # terminate container
    bf-s6 svc finish --terminate ...$args
}
